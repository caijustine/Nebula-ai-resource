# Copy this file to .env and fill in your own values (or export them directly
# in your shell before running the backend — see backend/README.md).
# Never commit .env to git.

# Optional — omit to use the default SQLite file (backend/local.db)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

ADMIN_PASSWORD=change_me_too

VITE_API_URL=http://localhost:8000
# Get your free key at cohere.com — no credit card needed
COHERE_API_KEY=
